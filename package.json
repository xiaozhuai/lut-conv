{
    "name": "lut-conv",
    "version": "1.1.1",
    "description": "A js library for converting and resizing lookup table (lut), supporting image and cube formats",
    "type": "module",
    "main": "./dist/lut-conv.cjs",
    "module": "./dist/lut-conv.mjs",
    "types": "./dist/lut-conv.d.mts",
    "exports": {
        ".": {
            "require": {
                "types": "./dist/lut-conv.d.cts",
                "default": "./dist/lut-conv.cjs"
            },
            "import": {
                "types": "./dist/lut-conv.d.mts",
                "default": "./dist/lut-conv.mjs"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsdown && cp dist/lut-conv.mjs web/js/lut-conv.mjs && cp dist/lut-conv.mjs.map web/js/lut-conv.mjs.map",
        "prepublishOnly": "npm run build",
        "test": "npm run build && node tests/main.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xiaozhuai/lut-conv.git"
    },
    "keywords": [
        "lut",
        "cube"
    ],
    "author": "xiaozhuai",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/xiaozhuai/lut-conv/issues"
    },
    "homepage": "https://github.com/xiaozhuai/lut-conv#readme",
    "devDependencies": {
        "@napi-rs/canvas": "^1.0.3",
        "tsdown": "0.23.0",
        "typescript": "^5.9.3"
    }
}
